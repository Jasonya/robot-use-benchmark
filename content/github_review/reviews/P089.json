  "paper_evidence": {
    "local_file": "audit/.cache/fulltext_review/P089/pages.json",
    "sha256": "8777449ad4493310deccdcb20c5c0d1887288034064d8353d2a478690fc966e6",
    "pdf_sha256": "2421f14228d394a1a2f683d8156f4ff953dee3dd1deefef64ce0037854b86be1",
    "pages_read": [
