{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:robot-use:count-record:0.1",
  "title":"A count with its native unit, scope and evidence",
  "type":"object",
  "required":["work_id","source_version","native_term","unit","granularity","scope","setting","count_context","value_kind","value","evidence"],
  "properties":{
    "work_id":{"type":"string"},
    "source_version":{"type":"string"},
    "native_term":{"type":"string"},
    "unit":{"enum":["native_activity","native_task","native_task_category","native_task_schema","native_task_registration","native_task_class","native_domain_category","native_scene","layout","style","task_instance","evaluation_case","episode","demonstration_pair","demonstration_trajectory","video","video_hour","frame","asset","asset_category","robot_profile","capability_category","model_entry","source_record","language_directive","canonical_g2","declared_goal_signature","annotation","participant","recording_session","camera_view","training_sample","workflow_step"]},
    "granularity":{"enum":["G0-native","G1-native","G2-native","G2-canonical","G3-native","G3","G4-native","G4","G5","R-scene","R-data","R-asset","facet","source-index"]},
    "scope":{"enum":["whole_resource","available_source_snapshot","training","validation","test","evaluated_subset","development_run","planning_target"]},
    "setting":{"enum":["simulation","real","offline","mixed","unknown","not_applicable"]},
    "count_context":{"type":"string","minLength":1},
    "value_kind":{"enum":["exact","at_least","approximate","range","unknown","not_applicable"]},
    "value":{"type":["number","null"],"minimum":0},
    "range_max":{"type":["number","null"],"minimum":0},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["source","locator","basis"],"properties":{"source":{"type":"string"},"locator":{"type":"string"},"basis":{"enum":["paper_report","pinned_code_count","data_manifest","actual_execution","planning_proposal","not_obtained"]}}}},
    "notes":{"type":"string"}
  },
  "allOf":[
    {"if":{"properties":{"value_kind":{"enum":["unknown","not_applicable"]}}},"then":{"properties":{"value":{"type":"null"}}}},
    {"if":{"properties":{"unit":{"const":"canonical_g2"}}},"then":{"properties":{"granularity":{"const":"G2-canonical"}}}},
    {"if":{"properties":{"value_kind":{"const":"range"}}},"then":{"required":["range_max"],"properties":{"value":{"type":"number"},"range_max":{"type":"number"}}}}
  ]
}
