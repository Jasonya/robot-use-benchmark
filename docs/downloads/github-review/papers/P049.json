{
  "paper_id": "P049",
  "name": "AntGPT",
  "title": "AntGPT: Can Large Language Models Help Long-term Action Anticipation from Videos?",
  "year": 2023,
  "paper_url": "https://arxiv.org/abs/2307.16368",
  "scope": "related_reference",
  "domain_ids": [],
  "status": "selected_core_source_sections_reviewed",
  "review": {
    "paper_id": "P049",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "AntGPT用LLM產生未來動作序列；Ego4D v1/v2、EPIC55及EGTEA仍是父資料，文字解析及序列修補是評測契約的重要部分。",
    "environment": "影片、caption／動作上下文和既有資料切分，非互動模擬環境。",
    "tasks": "長期verb/noun/action序列預測；候選序列及不同語言模型不增加獨立任務。",
    "data": "taxonomy/dicts.json、上下文與未來動作文字、LLM回應及相似度檢索池；腳本將序列截斷或補齊為20動作，並做詞彙映射。",
    "evaluation": "eval_icl.py逐樣本取K候選最小正規化editdistance.eval。短/空答案有補齊策略，未知詞有模糊匹配和預設類別；action ED在此腳本使用verb/noun索引相加，需與官方定義核對。",
    "standardization": {
      "profile": "action_sequence_anticipation",
      "reuse": "父資料血緣、候選輸出、vocab映射與原作解析／評分程式。",
      "transform": "case保存上下文模式、候選K、20個動作的horizon、prompt/檢索池版本及修補規則；不得把20動作當20秒或20道新題。",
      "missing": "原始素材及split閉合、解析失敗處理、action度量對照官方evaluator及本庫協定。"
    },
    "version_note": "此核讀針對指定GPT ICL腳本；不能把其他GPT/Llama/Transformer腳本的配置及成績當同一協定。",
