  "review": {
    "paper_id": "P024",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "EPIC Fields分成重建/讀取工具與NVS、UDOS評測；epic-fields本身只是網頁倉庫，不能當作評測程式。",
    "environment": "相機與點雲是影片觀測幾何；video-scene與原廚房一對多，不能每影片都新增可操作環境。",
    "tasks": "NVS、動態/半靜態分割、VISOR衍生VOS是不同資訊/世界模型評測端點。",
    "data": "JSON的camera採COLMAP/OpenCV內參，images為qw-first quaternion加translation的world-to-camera，points含XYZRGB。評測另需EPIC100影格、mask、split與模型cache。",
    "evaluation": "NVS先逐影片平均PSNR再跨影片平均，前景/背景僅在適用within-action列出。UDOS依有效mask畫素算AP、排除無有效標籤影格，motion型別分報。",
    "standardization": {
      "profile": "multi_view_geometry_and_reconstruction",
      "reuse": "video/frame ID、相機轉換、原生NVS/UDOS split與評分。",
      "transform": "明記W2C、qw順序與軸方向；轉NeRF時儲存反轉/翻軸。兩種case的可見輸入、mask與聚合分母分開。",
      "missing": "對應版本的EPIC100素材、標註與模型輸出閉合、影片重用核對和本庫evaluator。"
    },
    "version_note": "評測README明示2024-02-10標註更新，並給前版commit；原始arXiv與新版不能混用。",
