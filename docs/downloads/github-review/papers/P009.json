{
  "paper_id": "P009",
  "name": "EPIC-KITCHENS",
  "title": "Scaling Egocentric Vision: The EPIC-KITCHENS Dataset",
  "year": 2018,
  "paper_url": "https://arxiv.org/abs/1804.02748",
