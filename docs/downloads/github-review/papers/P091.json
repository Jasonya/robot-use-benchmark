{
  "paper_id": "P091",
  "name": "UniFolding",
  "title": "UniFolding: Towards Sample-efficient, Scalable, and Generalizable Robotic Garment Folding",
  "year": 2023,
  "paper_url": "https://arxiv.org/abs/2311.01267",
  "scope": "benchmark_or_data_source",
