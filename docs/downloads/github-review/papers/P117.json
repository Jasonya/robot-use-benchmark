{
  "paper_id": "P117",
  "name": "UMI",
  "title": "Universal Manipulation Interface: In-The-Wild Robot Teaching Without In-The-Wild Robots",
  "year": 2024,
  "paper_url": "https://arxiv.org/abs/2402.10329",
  "scope": "related_reference",
