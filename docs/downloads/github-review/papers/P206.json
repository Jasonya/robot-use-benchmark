{
  "paper_id": "P206",
  "name": "EmbodiedMemory-Bench",
  "title": "EmbodiedMemory-Bench: Benchmarking Embodied Memory for Long-Horizon Embodied Tasks",
  "year": 2026,
  "paper_url": "https://arxiv.org/abs/2609.28236",
  "scope": "benchmark_or_data_source",
