  "review": {
    "paper_id": "P055",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "FUTR重用Breakfast與50Salads，預測動作類別及持續比例；觀測／預測百分比和frame級MoC是原生協定的一部分。",
    "environment": "既有長影片及預計算視覺特徵，無新可操作場景。",
    "tasks": "從過去影片預測後續動作分段；一支影片的多個觀測比例是不同評測設定，不是不同語義任務。",
    "data": "groundTruth逐影格標籤、features/*.npy及mapping.txt；dataset返回features、past_label、trans_future_target、trans_future_dur，保留sample_rate、NONE、pad_idx及n_query截斷。",
    "evaluation": "predict.py將預測類別／duration展開到未來影格，再按觀測與預測比例截取；eval_file累積每類正誤影格，最後對有GT的類別平均得到MoC，非全影格micro accuracy。",
    "standardization": {
      "profile": "long_horizon_action_segmentation_forecasting",
      "reuse": "來源影片／split、逐影格GT、類別字典與MoC計算。",
      "transform": "case保留來源影片長度、obs_fraction、pred_fraction、特徵步長及label mapping；duration比例要連同影片長度保存，不改寫成固定秒數。",
      "missing": "影片／特徵閉合、Breakfast四split／50Salads五split核對及共同輸出adapter。"
    },
    "version_note": "FUTR是方法repo，父資料與EGO-TOPO／其他預測方法可能重用；樣本窗口與原片不能重複相加。",
