  "review": {
    "paper_id": "P048",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "EGO-TOPO把影片中的活動區域建成圖，再用於動作預測；圖節點不是已重建且可操作的房屋場景。",
    "environment": "EPIC55與EGTEA影片、推斷的活動區域及訪問圖；保存video來源與時間關係。",
    "tasks": "拓撲活動圖與長期動作預測，是既有資料上的方法／表示，不新增獨立資料集。",
    "data": "每影片graph.pth、locnet特徵與配對分數；epic_utils用video、start/end frame、labels及圖歷史選出指定frame的圖。",
    "evaluation": "metrics.py提供top-k accuracy、逐類平均top-k recall與TTA；圖建構品質和動作預測分數需分項。",
    "standardization": {
      "profile": "video_graph_and_action_anticipation",
      "reuse": "父影片ID、圖／visit時間、特徵引用與動作評測。",
      "transform": "圖存context衍生資源，保留產生器和source hash；用觀測截止點取圖歷史，不把完整未來圖自動暴露給模型。",
      "missing": "原片與預計算特徵、建圖窗口/切分核對及evaluator接線。"
    },
    "version_note": "EPIC/EGTEA資料與其後AntGPT等工作重用，不能將圖或模型論文各自的資料量相加。",
    "runtime_executed": false,
