{
  "paper_id": "P011",
  "name": "EPIC-KITCHENS VISOR",
  "title": "EPIC-KITCHENS VISOR Benchmark: VIdeo Segmentations and Object Relations",
  "year": 2022,
  "paper_url": "https://arxiv.org/abs/2209.13064",
  "scope": "benchmark_or_data_source",
