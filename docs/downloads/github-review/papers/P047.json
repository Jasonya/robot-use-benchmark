  "review": {
    "paper_id": "P047",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "AVT是重用EK55/EK100、EGTEA及50Salads的預測方法；README還固定了外部RULSTM commit，必須把模型repo與父資料／評測來源分開。",
    "environment": "影片或預取特徵的觀測脈絡，無互動場景定義。",
    "tasks": "依tau_a提前量及tau_o觀測長度做動作預測，另有未來特徵學習；辨識與預測模式不能混用。",
    "data": "base_video_dataset保存orig_start/orig_end，轉換出過去窗口和future_i窗口並另記discarded樣本；不同資料根目錄與特徵頻率保留。",
    "evaluation": "BasicLossAccuracy對各target類型計cross-entropy、top1/top5；common.utils.accuracy會展平時間維。正式EPIC評測另依README固定的RULSTM接口。",
    "standardization": {
      "profile": "action_anticipation",
      "reuse": "時間窗轉換、target字典、標籤空間及原生metric。",
      "transform": "case分開context、未來reference、tau_a/tau_o和資料版本；future欄位作訓練目標或評分證據，不能自動全部給推論端。",
      "missing": "素材閉合、外部RULSTM指定版本、discarded分母與共同split核對。"
    },
    "version_note": "原作外部RULSTM固定57842b27d6264318be2cb0beb9e2f8c2819ad9bc；不能默認使用其他commit的評測。",
