{
  "paper_id": "P060",
  "name": "Continuous 4D interaction forecasting",
  "title": "From Where to How: Continuous 4D Interaction Forecasting from Egocentric Video",
  "year": 2026,
  "paper_url": "https://arxiv.org/abs/2609.08636",
  "scope": "benchmark_or_data_source",
