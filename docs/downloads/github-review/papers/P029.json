  "review": {
    "paper_id": "P029",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "EgoThink 是單影像第一人稱思考問答。已核讀資料樣本、推論輸出、實際裁判 prompt 選擇與分數聚合；程式沿用 FastChat 格式，但原生分數不是其通用 1–10 分。",
    "environment": "來自人類第一人稱影像；樣本 source_dataset=ego4d，image_path 為本地圖片。能力目錄不等於生活場域或新實體環境；原影片時間／地點需另外補來源對映。",
    "tasks": "六類能力目錄 Activity、Forecast、Localization、Object、Planning、Reasoning，下含 12 份 annotations.json。導航／協助題是文字規劃問答，未要求機器人執行。",
    "data": "樣本含 source_dataset、image_path、question、answer；eval.py 用 image_path[0] 的檔名定位影像，依目錄順序重新給 question_id，輸出 question/model_answer/reference_answer JSONL。assistance/navigation token 預算300，其他30，需保留差異。",
    "evaluation": "gen_judgment.py 實際採 judges[math] 的 single-math-v2 prompt：只看問題、參考與模型文字、不看圖片，給 0/.5/1；common.py 解析 [[rating]]，最多嘗試3次，失敗=-1。show_result.py 排除 -1 後平均，去重被註解；應額外報有效率和重複題，不能將保留樣本平均當全題 accuracy。",
    "standardization": {
      "profile": "image_qa_reference_judge",
      "reuse": "十二能力題集結構、單影像 QA schema、原參考答案與具體 0/.5/1 裁判流程。",
      "transform": "case 用 source+能力目錄+原始 row/hash 建穩定 ID，儲存生成 question_id 對映；記錄圖片、token budget、reference、judge model/version/prompt、原 judgment、解析重試與缺失。各能力分項，與 physical navigation evaluator 分開。",
      "missing": "未執行模型／付費裁判。僅讀 Activity 第一筆資料樣本，未逐題查圖片與標籤；需確認各子集來源 video/time、去重與盲測切分。API 模型版本與裁判可靠性需另外驗證。"
    },
    "version_note": "README 列 VidEgoThink 為另一篇後續工作；不能因同 repo 宣傳連結就把其影片題目計入 EgoThink。現行預設裁判為 gpt-4o，原論文使用的模型／prompt 必須另依對應版本釘選。",
    "runtime_executed": false,
