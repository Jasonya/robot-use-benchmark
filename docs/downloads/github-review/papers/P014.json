{
  "paper_id": "P014",
  "name": "Ego-Exo4D",
  "title": "Ego-Exo4D: Understanding Skilled Human Activity from First- and Third-Person Perspectives",
  "year": 2023,
  "paper_url": "https://arxiv.org/abs/2311.18259",
  "scope": "benchmark_or_data_source",
  "domain_ids": [
