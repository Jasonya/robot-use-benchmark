  "paper_id": "P188",
  "name": "DRAPER",
  "title": "DRAPER: Towards a Robust Robot Deployment and Reliable Evaluation for Quasi-Static Pick-and-Place Cloth-Shaping Neural Controllers",
  "year": 2024,
  "paper_url": "https://arxiv.org/abs/2409.15159",
