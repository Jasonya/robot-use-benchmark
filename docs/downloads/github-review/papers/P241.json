{
  "paper_id": "P241",
  "name": "AFF-ttention",
  "title": "AFF-ttention! Affordances and Attention models for Short-Term Object Interaction Anticipation",
  "year": 2024,
  "paper_url": "https://arxiv.org/abs/2406.01194",
  "scope": "benchmark_or_data_source",
  "domain_ids": [
    "food"
