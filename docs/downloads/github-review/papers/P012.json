{
  "paper_id": "P012",
  "name": "HD-EPIC",
  "title": "HD-EPIC: A Highly-Detailed Egocentric Video Dataset",
  "year": 2025,
  "paper_url": "https://arxiv.org/abs/2502.04144",
  "scope": "benchmark_or_data_source",
