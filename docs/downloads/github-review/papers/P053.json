  "review": {
    "paper_id": "P053",
    "reviewed_on": "2026-10-10",
    "status": "selected_core_source_sections_reviewed",
    "summary": "HandsOnVLM公開了EPIC手軌跡與reasoning資料接口；核讀發現評分變數命名和實際函數不一致，必須保留程式版本並先校核。",
    "environment": "EPIC-KITCHENS第一人稱影片與人類手軌跡；reasoning子集由有對應提問的影格篩選。",
    "tasks": "一般或文字條件的雙手未來2D軌跡預測；預設評估入口是ek100 validation，非所有父資料的統一測試。",
    "data": "dataset提供future_hands[2,5,2]、future_valid[2]、contact_point、image_abs_paths及prompt；評分移除首點後用雙手×4個未來點。reasoning用valid_index篩子集，影像張量的重複不增加題數。",
    "evaluation": "traj_eval含ADE/FDE與四步加權WDE、位置及手的有效遮罩；但evaluate_traj_stochastic把compute_fde存為ade、compute_ade存為fde，最後回傳均值而非已算出的min。推論包裝還跳過無效生成，需另報覆蓋率。",
    "standardization": {
      "profile": "language_conditioned_hand_trajectory_forecasting",
      "reuse": "EPIC來源鏈、prompt／軌跡欄位、reasoning篩選和有效遮罩。",
      "transform": "case保留提問、原始影格ID、2D正規化座標、4步時間點與valid masks；metric保存實際函數、候選數及失敗輸出處理，不直接信任列印名稱。",
      "missing": "外部資產及原始EPIC影片、時間步長核對、評分命名／均值修正對照與完整推論接線。"
    },
    "version_note": "靜態核讀另見inference正常回傳3項而evaluate_epic_kitchen_traj以2項接收；尚未執行，不能宣稱此commit可直接跑通或原文數值有相同問題。",
    "runtime_executed": false,
