{
  "paper_id": "P178",
  "name": "RoboRecover",
  "title": "RoboRecover: Benchmarking Robot Policy Recovery under Execution Deviations",
  "year": 2026,
  "paper_url": "https://arxiv.org/abs/2609.28952",
  "scope": "benchmark_or_data_source",
